# Copy to .env.local, set your own strong password, then restart the Node.js server.
# Server-only; never use a NEXT_PUBLIC_ prefix. At least 16 characters.
ADMIN_PASSWORD=

# Optional: set true when serving through an HTTPS reverse proxy.
# For a trusted local network over HTTP, leave false.
ADMIN_COOKIE_SECURE=false

# Server-only token for a PRIVATE Vercel Blob Store connected to this project.
# Never use a NEXT_PUBLIC_ prefix and never commit the real token.
BLOB_READ_WRITE_TOKEN=
